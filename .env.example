# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) — безопасен для браузера, доступ ограничен RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Боевой адрес сайта (для QR-кодов, sitemap, canonical)
NEXT_PUBLIC_SITE_URL=https://bolakay.uz
